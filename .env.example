# ============================================================
# LexiScan AI — Environment Configuration
# ============================================================

# Google Gemini API Key (Required for AI Analysis and Q&A)
# Obtain your free API key at: https://aistudio.google.com/
# On Render: Add this under Dashboard -> Environment -> Environment Variables
GEMINI_API_KEY="your-gemini-api-key-here"

# Server Port (Render sets PORT automatically to 10000; default locally is 3000)
PORT=3000

# Gemini Model Selection (Optional; defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Node Environment (production / development)
NODE_ENV="production"

